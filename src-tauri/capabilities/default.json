{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$APPCONFIG/gre-vocabulary.db" }]
    },
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
